import PaymentModal from '../components/PaymentModal.astro';
import Technology from '../components/Technology.astro';
import TechnologyDialog from '../components/TechnologyDialog.astro';
import Testimonials from '../components/Testimonials.astro';
import SavingsCalculator from '../components/SavingsCalculator.astro';
import Promotion from '../components/Promotion.astro';
import Plans from '../components/Plans.astro';
import Booking from '../components/Booking.astro';
import InterestMenu from '../components/InterestMenu.astro';
import Faq from '../components/Faq.astro';
