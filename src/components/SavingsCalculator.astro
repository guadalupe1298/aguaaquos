<section class="savings-section section-transition" id="ahorro">
      <div class="shell">
        <div class="calc-entry">
          <h3>¿Cuánto gastas hoy en garrafones?</h3>
        </div>
        <div id="calculadora" class="calc-section">
          <h3>Garrafones vs. AquosLife</h3>
          <p class="calc-benefit">Además de una vida más cómoda, tendrás un ahorro estimado de:</p>
          <div class="calculator">
            <div class="calc-inputs">
              <label for="people">Personas en casa<select id="people">
                  <option value="1">1 persona</option>
                  <option value="2">2 personas</option>
                  <option value="3" selected>3 personas</option>
                  <option value="4">4 personas</option>
                  <option value="5">5 personas</option>
                  <option value="6">6 personas</option>
                  <option value="7">7 o más personas</option>
                </select>
              </label>
              <label for="jug-price">Precio por garrafón xsxsx(MXN)<input id="jug-price" type="number" min="1" max="500"
                  step="1" value="$60" inputmode="numeric">
              </label>
            </div>
            <div class="calc-results">
              <div>
                <span>Garrafones al mes, estimados</span>
                <strong id="jugs">6.8</strong>
              </div>
              <div>
                <span>Gasto actual en garrafones</span>
                <strong id="current-cost">$405</strong>
              </div>
              <div>
                <span id="suggested-plan">AquosLife Life</span>
                <strong id="plan-cost">$299</strong>
              </div>
              <div class="savings">
                <span>Diferencia mensual estimada</span>
                <strong id="monthly-saving">$106</strong>
              </div>
              <div class="savings">
                <span>Diferencia anual estimada</span>
                <strong id="annual-saving">$1,272</strong>
              </div>
            </div>
          </div>
          <div class="calc-offer">
            <p>
              <strong>Contrata hoy</strong> y obtén instalación y un mes de prueba gratis.
            </p>
            <span class="urgency">Cupo promocional limitado · Agenda hoy para conservarlo</span>
            <a class="primary" href="#agendar">Agendar instalación →</a>
          </div>
        </div>
      </div>
    </section>
